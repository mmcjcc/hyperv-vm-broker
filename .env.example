# vm-broker client settings, per machine. Names only: copy to %LOCALAPPDATA%\vm-broker\client.env (Windows) or
# ~/.config/vm-broker/client.env (Linux) and fill in; environment variables of the same names override the file.
# Never in a consumer repo, never committed. No secret ever goes in this file. The host credential comes from
# netadmin's DPAPI cache (v0.1) or from your SSH key (v1); guest passwords, director tokens and the MAK live on the
# Hyper-V host, never on the client.
#
# The consumer name is not set here: vmb and the MCP server read it from vmbroker/consumer at the root of the
# project repo (docs/design.md 3.4).

# direct (v0.1: the operator's laptop, WinRM + Kerberos) or ssh (v1: the gate on each host)
VMB_TRANSPORT=
# hosts the client may use, comma-separated (for example servera); vmb asks each of them to find a VM by name
VMB_HOSTS=
# v0.1 only: path to netadmin's tools\Get-HomelabCredential.ps1, which returns a PSCredential (never a value here).
# The client always passes -ConfigPath with a path that does not exist, so a missing DPAPI cache is an error, never a
# read of netadmin's config.txt.
VMB_CREDENTIAL_LOADER=
# v1 only: prefix of the ssh host aliases (aliases are <prefix><host>, for example vmb-servera)
VMB_SSH_ALIAS_PREFIX=
# where copy_from, screenshots and the full output of a cut vm_run result go; outside OneDrive
# (default C:\work\recordings\<consumer>)
VMB_OUT_DIR=
# seconds a tool waits for a job before returning its id (default 120, at most 600)
VMB_WAIT_S=
